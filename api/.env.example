# Staging configuration only. This backend deliberately refuses production
# startup while OTP and payments are simulated. Credentials alone do not fix it.
NODE_ENV=staging
PORT=4600
DB_PATH=/absolute/path/to/persistent/staging-shaadi.db
SEED_DEMO_DATA=false
JWT_SECRET=replace-with-a-random-secret-kept-on-the-server
ADMIN_PHONES=replace-with-approved-admin-phone-numbers
# Load these values through the host's environment settings. npm start does not
# automatically read .env. Existing demo records are not deleted by this flag.
